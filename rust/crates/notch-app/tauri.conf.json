{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch",
  "mainBinaryName": "Notch",
  "identifier": "io.github.brick-bread.notch",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "notch",
        "title": "Notch",
        "url": "notch.html",
        "width": 980,
        "height": 96,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
