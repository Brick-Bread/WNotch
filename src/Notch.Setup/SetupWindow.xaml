<Window x:Class="Notch.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch Setup" Width="612" Height="468"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- The pill grows out of a dot, like the notch itself. -->
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Width"
                                     From="38" To="132" BeginTime="0:0:0.25" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Root" Margin="16" CornerRadius="16" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero: a soft blue glow with the pill on it. -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                        <GradientStop Color="#245EA1FF" Offset="0" />
                        <GradientStop Color="#005EA1FF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="Pill" Grid.Row="0" Width="38" Height="38" CornerRadius="19" Background="#F2F2F5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="46" ShadowDepth="0" Opacity="0.45" Color="#5EA1FF" />
                </Border.Effect>
                <Border x:Name="Dot" Width="22" Height="16" CornerRadius="8" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right" Margin="0,0,11,0" Opacity="0" />
            </Border>
            <Button Grid.Row="0" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Click="OnClose" ToolTip="Close" />

            <!-- Content -->
            <Grid Grid.Row="1" Margin="40,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               TextAlignment="Center" Text="Install Notch" />
                    <TextBlock x:Name="Subtitle" Margin="0,6,0,0" FontSize="13.5" TextAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" MaxWidth="460" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <!-- Install options -->
                    <StackPanel x:Name="OptionsPanel">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Install location" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="DirText" Margin="0,3,0,0" FontSize="13" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="ChangeButton" Grid.Column="1" Content="Change…" Style="{StaticResource LinkButton}"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Click="OnChangeFolder" />
                            </Grid>
                        </Border>
                        <CheckBox x:Name="StartupCheck" Margin="4,18,0,0" Content="Start Notch when I sign in to Windows" IsChecked="True" />
                        <CheckBox x:Name="DesktopCheck" Margin="4,12,0,0" Content="Add a shortcut to the desktop" />
                    </StackPanel>

                    <!-- Uninstall options -->
                    <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                        <CheckBox x:Name="SettingsCheck" Margin="4,10,0,0" HorizontalAlignment="Center"
                                  Content="Also delete my settings and shelf" />
                    </StackPanel>

                    <!-- Working -->
                    <StackPanel x:Name="WorkPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,10,0,0">
                        <ProgressBar x:Name="Bar" />
                        <TextBlock x:Name="Status" Margin="0,12,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Finished -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                        <CheckBox x:Name="LaunchCheck" Margin="4,10,0,0" HorizontalAlignment="Center"
                                  Content="Start Notch now" IsChecked="True" />
                    </StackPanel>

                    <!-- Failed -->
                    <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#1FFF6B6B" CornerRadius="12" Padding="16,12"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ErrorText" FontSize="12.5" Foreground="{StaticResource ErrorBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="40,0,40,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Note" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnSecondary" />
                    <Button x:Name="PrimaryButton" Content="Install" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="OnPrimary" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
