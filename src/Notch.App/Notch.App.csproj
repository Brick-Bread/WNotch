<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Notch</AssemblyName>
    <RootNamespace>Notch.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Notch.Hook.exe is published into the same folder with the same runtime settings; see release.yml. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notch.Core\Notch.Core.csproj" />
    <ProjectReference Include="..\Notch.Platform\Notch.Platform.csproj" />
    <!-- Not used as a library: referenced so Notch.Hook.exe is built and copied next to Notch.exe. -->
    <ProjectReference Include="..\Notch.Hook\Notch.Hook.csproj" />
    <ProjectReference Include="..\Notch.Cli\Notch.Cli.csproj" />
    <!-- Not used as a library either: built so ShipBuiltInPlugins can copy it into the plugins folder. -->
    <ProjectReference Include="..\..\builtin\NewAgeTheme\NewAgeTheme.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The plugins that ship with Notch go in plugins\<name> next to Notch.exe, in the build and in what is
       published, where PluginManager.BuiltInDirectory finds them. They are built by the references above. -->
  <PropertyGroup>
    <NewAgeThemeOutput>..\..\builtin\NewAgeTheme\bin\$(Configuration)\net10.0\</NewAgeThemeOutput>
  </PropertyGroup>
  <Target Name="ShipBuiltInPlugins" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_NewAgeThemeFile Include="$(NewAgeThemeOutput)**\*" Exclude="$(NewAgeThemeOutput)**\*.pdb;$(NewAgeThemeOutput)**\*.deps.json" />
      <Content Include="@(_NewAgeThemeFile)" Link="plugins\new-age\%(_NewAgeThemeFile.RecursiveDir)%(_NewAgeThemeFile.Filename)%(_NewAgeThemeFile.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- The xterm.js page the terminal's WebView2 loads from disk. -->
    <Content Include="Assets\terminal\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The plugin Notch puts in opencode's plugins folder, with the setting that lets agents report; see AgentHookFiles. -->
    <Content Include="Assets\opencode\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sounds agents make when they are done or need the user, unless the user picked their own; see AgentSoundPlayer. -->
    <Content Include="Assets\sounds\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Inter, the font used when SF Pro is not installed (Themes/Design.xaml). -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
