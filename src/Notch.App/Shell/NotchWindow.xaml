<Window x:Class="Notch.App.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Notch.App.Shell"
        Title="Notch"
        Width="980" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}">

    <!-- The window is as large as the notch ever gets. Everything outside the island is
         transparent, and transparent pixels of a layered window pass clicks through. -->
    <Grid x:Name="Root">
        <!-- Behind the island and slightly larger: a lit rim and its glow show. Sized and shaped in code.
             The first is only lit while a plugin draws the glow in segments (IPluginGlow). -->
        <Border x:Name="GlowSpectrum" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="GlowLayer" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" />
        <Border x:Name="GlowCore" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" />

        <!-- Fills the gap between a floating island and the screen edge. All but invisible, yet
             enough for Windows to deliver the pointer here, so pushing it against the edge opens the island. -->
        <Border x:Name="EdgeBridge" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed" />

        <!-- A notch's shoulders: small inward curves where its sides meet the top of the screen, as on the
             hardware. Only shown for a notch at the top; placed beside the island in ApplyShape. -->
        <Path x:Name="ShoulderLeft" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top"
              Data="M0,0 H10 V10 A10,10 0 0 0 0,0 Z" Fill="{DynamicResource IslandBrush}" IsHitTestVisible="False"
              Visibility="Collapsed" />
        <Path x:Name="ShoulderRight" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top"
              Data="M10,0 H0 V10 A10,10 0 0 1 10,0 Z" Fill="{DynamicResource IslandBrush}" IsHitTestVisible="False"
              Visibility="Collapsed" />

        <!-- Alignment and margins of the island, the glow and the bridge are set in code from the
             position and style settings; these are the values for a notch at the top. -->
        <Grid x:Name="Island" Width="180" Height="32"
              HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource IslandBrush}">

            <!-- The pill: what it is on the left (an agent's logo, album art or a glyph), a line of text in the
                 middle that scrolls when it is too long, and the state on the right. Filled in by Refresh. -->
            <Grid x:Name="CompactLayer" Margin="14,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CompactScale" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <TextBlock x:Name="CompactGlyph" FontFamily="{DynamicResource IconFont}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Path x:Name="CompactLogo" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Border x:Name="CompactArt" CornerRadius="{DynamicResource SmallRadius}" Visibility="Collapsed" />
                </Grid>

                <shell:Marquee Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                        <Run x:Name="CompactTitle" /><Run x:Name="CompactSubtitle" FontWeight="Medium"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                    </TextBlock>
                </shell:Marquee>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- An agent at work: three dots that blink in turn. -->
                    <StackPanel x:Name="CompactDots" Orientation="Horizontal" Visibility="Collapsed">
                        <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="{DynamicResource WorkingBrush}" />
                        <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="{DynamicResource WorkingBrush}" />
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource WorkingBrush}" />
                    </StackPanel>
                    <!-- Music: four bars that move to it. -->
                    <StackPanel x:Name="CompactWave" Orientation="Horizontal" Height="12" Visibility="Collapsed">
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5" />
                    </StackPanel>
                    <TextBlock x:Name="CompactStateGlyph" FontFamily="{DynamicResource IconFont}" FontSize="11"
                               Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="CompactDetail" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="CompactProgress" Width="84" Height="5" Maximum="1" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource TrackBrush}" />
                    <TextBlock x:Name="CompactLevel" Width="22" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                               FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <!-- Fixed size per tab, so the content is revealed by the growing island instead of reflowing. -->
            <Grid x:Name="ExpandedLayer" Width="600" Height="324" Margin="0,14,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- A row of icons; a plugin's page adds its title after them. -->
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="TabHome" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE80F;" ToolTip="Home" IsChecked="True" />
                    <RadioButton x:Name="TabTerminal" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE756;" ToolTip="Terminal" />
                    <RadioButton x:Name="TabStats" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE9D2;" ToolTip="Stats" />
                    <RadioButton x:Name="TabShelf" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE7B8;" ToolTip="Shelf" />
                    <!-- Only shown while the clipboard history is switched on in settings. -->
                    <RadioButton x:Name="TabClipboard" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE77F;" ToolTip="Clipboard"
                                 Visibility="Collapsed" />
                    <!-- Only shown while a plugin has a card to put on it. -->
                    <RadioButton x:Name="TabPlugins" Style="{DynamicResource TabButton}" FontFamily="{DynamicResource IconFont}" FontSize="13" Width="24" Padding="0" Content="&#xE71D;" ToolTip="Plugins"
                                 Visibility="Collapsed" />
                </StackPanel>
                <!-- Only on Home: switches it into rearranging its widgets and back. -->
                <Button x:Name="HomeEditButton" Style="{DynamicResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="24" Height="24" FontSize="12" Margin="0,0,28,0"
                        Foreground="{DynamicResource SecondaryTextBrush}" Content="&#xE70F;" ToolTip="Edit Home" />
                <Button x:Name="OpenSettingsButton" Style="{DynamicResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="24" Height="24" FontSize="13"
                        Foreground="{DynamicResource SecondaryTextBrush}" Content="&#xE713;" ToolTip="Settings" />

                <!-- Home: the widgets the user chose, in rows of one or two. Laid out in code (NotchWindow.Home.cs).
                     Beneath the tab row: its scroller reaches up over the tabs for the media card's wash, and a
                     scroller takes every click on it, so the tabs and buttons must be above it to be clicked. -->
                <Grid x:Name="HomePanel" Grid.Row="1" Margin="0,16,0,0" Panel.ZIndex="-1">
                    <!-- Scrolls (wheel only) once the notch has grown as tall as it may. -->
                    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel>
                            <StackPanel x:Name="HomeRows" Background="Transparent" />
                            <TextBlock x:Name="HomeEmpty" Opacity="0.45" HorizontalAlignment="Center" Margin="0,24"
                                       Text="Nothing on Home. Click the pencil to add widgets." Visibility="Collapsed" />
                            <!-- Under the widgets while they are being rearranged. -->
                            <DockPanel x:Name="HomeEditBar" LastChildFill="False" Visibility="Collapsed">
                                <Button x:Name="HomeAdd" DockPanel.Dock="Left" Style="{DynamicResource PillButton}" Margin="0"
                                        Content="+ Add widget" Background="{DynamicResource AccentHoverBrush}" />
                                <Button x:Name="HomeReset" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                        Content="Reset" ToolTip="Put back the widgets Home starts with" />
                                <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Drag a widget to move it" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Takes Home's place while a widget is picked or set up. -->
                    <DockPanel x:Name="HomeSheet" Visibility="Collapsed" VerticalAlignment="Top">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button x:Name="HomeSheetDone" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                    Content="Save" Background="{DynamicResource AccentHoverBrush}" />
                            <Button x:Name="HomeSheetCancel" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                    Content="Cancel" />
                            <TextBlock x:Name="HomeSheetTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Scrolls (wheel only) when the picker or a forecast is taller than the notch may grow. -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="HomeSheetBody" />
                        </ScrollViewer>
                    </DockPanel>

                    <!-- The cards Home has always had. Code moves each into its place among the rows. -->
                    <StackPanel x:Name="HomeParts" Visibility="Collapsed">
                        <Grid x:Name="MediaCard">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The artwork again, large and blurred, washing the island in its colour. -->
                            <!-- On a canvas, which lets it spill past the card without being cut off at the card's edge. -->
                            <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                                <Border x:Name="MediaWash" Canvas.Left="-60" Canvas.Top="-50" Width="340" Height="240" Opacity="0.4">
                                    <Border.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#66000000" Offset="0.45" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.OpacityMask>
                                    <Border.Effect>
                                        <BlurEffect Radius="40" RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                            </Canvas>

                            <Grid Width="96" Height="96">
                                <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource ControlBrush}">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="30"
                                               Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="MediaArt" CornerRadius="{DynamicResource CardRadius}" />
                            </Grid>

                            <Grid Grid.Column="1" Margin="18,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <shell:Marquee HorizontalAlignment="Left">
                                    <TextBlock x:Name="MediaTitle" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="15"
                                               FontWeight="SemiBold" />
                                </shell:Marquee>
                                <TextBlock x:Name="MediaArtist" Grid.Row="1" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- The time gone and the time left on either side of the bar. -->
                                <Grid x:Name="MediaTimeline" Grid.Row="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MediaElapsed" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" />
                                    <!-- Taller than the bar so it is easy to hit. -->
                                    <Border x:Name="MediaSeekArea" Grid.Column="1" Height="14" Margin="10,0" Background="Transparent">
                                        <ProgressBar x:Name="MediaProgress" Height="4" Maximum="1"
                                                     VerticalAlignment="Center" IsHitTestVisible="False"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" />
                                    </Border>
                                    <TextBlock x:Name="MediaRemaining" Grid.Column="2" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Typography.NumeralAlignment="Tabular" />
                                </Grid>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,-6">
                                    <Button x:Name="MediaPrevious" Style="{DynamicResource IconButton}" Content="&#xF8AC;" FontSize="16" />
                                    <Button x:Name="MediaPlayPause" Style="{DynamicResource IconButton}" Content="&#xF5B0;"
                                            Width="40" Height="40" FontSize="22" Margin="14,0" />
                                    <Button x:Name="MediaNext" Style="{DynamicResource IconButton}" Content="&#xF8AD;" FontSize="16" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Coding agents, in Notch's terminal or running anywhere else. -->
                        <Border x:Name="AgentsCard" Style="{DynamicResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Agents" Style="{DynamicResource CardLabel}" />
                                <ItemsControl x:Name="AgentList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Cursor="Hand" Height="28" Tag="{Binding}"
                                                    MouseLeftButtonDown="OnAgentRowClicked" ToolTip="{Binding Tip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- The agent's logo, or its glyph when it has none. -->
                                                    <Path Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" Data="{Binding Logo}"
                                                          Fill="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Where}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="10,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <!-- The state, in its own colour. -->
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Foreground="{Binding Brush}"
                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <Border x:Name="TimerCard" Style="{DynamicResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <!-- Negative margins keep the label row as low as it is without the button. -->
                                    <Button x:Name="TimerCustom" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="+ Custom" FontSize="11" Padding="9,2" Margin="0,-3,-6,-3"
                                            ToolTip="Set a timer of any length" />
                                    <TextBlock x:Name="TimerLabel" Text="Timer" Style="{DynamicResource CardLabel}" />
                                </DockPanel>
                                <!-- Wraps to a second row when the presets do not fit on one. -->
                                <WrapPanel x:Name="TimerPresets" DockPanel.Dock="Bottom" Margin="-6,0,0,0">
                                    <Button x:Name="TimerPomodoro" Style="{DynamicResource PillButton}" Content="Pomodoro"
                                            Margin="6,6,0,0" Background="{DynamicResource AccentHoverBrush}"
                                            ToolTip="Focus and break sessions back to back; lengths are in Settings" />
                                    <!-- A button per preset from the settings follows, added in code. -->
                                </WrapPanel>
                                <!-- Takes the place of the presets while a length is being typed. -->
                                <DockPanel x:Name="TimerEntry" DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Button x:Name="TimerEntryCancel" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="Cancel" />
                                    <Button x:Name="TimerEntryStart" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="Start" Background="{DynamicResource AccentHoverBrush}" />
                                    <TextBox x:Name="TimerInput" Style="{StaticResource PillTextBox}" MaxLength="24"
                                             ToolTip="A number is minutes. Also 1:30, 90s, 1h20m. Enter starts, Esc cancels." />
                                </DockPanel>
                                <StackPanel x:Name="TimerControls" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            Margin="-6,6,0,0" Visibility="Collapsed">
                                    <Button x:Name="TimerPauseResume" Style="{DynamicResource PillButton}" Content="Pause" />
                                    <Button x:Name="TimerReset" Style="{DynamicResource PillButton}" Content="Cancel" />
                                </StackPanel>
                                <!-- Shrinks the digits when two rows of presets leave them less room. -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="TimerText" Text="0:00" FontFamily="{DynamicResource DisplayFontFamily}"
                                               FontSize="40" FontWeight="Light" Typography.NumeralAlignment="Tabular" />
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <Border x:Name="CalendarCard" Style="{DynamicResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="CalendarDate" DockPanel.Dock="Top" Style="{DynamicResource CardLabel}" />
                                <TextBlock x:Name="CalendarEmpty" Opacity="0.45" TextWrapping="Wrap" FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <ItemsControl x:Name="CalendarList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- One colour per feed, so calendars can be told apart. -->
                                                <Ellipse Width="6" Height="6" HorizontalAlignment="Left"
                                                         VerticalAlignment="Center" Fill="{Binding Dot}" />
                                                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12" Opacity="0.6" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Terminal -->
                <Grid x:Name="TerminalPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="TerminalFolder" Style="{DynamicResource PillButton}" />
                            <StackPanel x:Name="TerminalLaunchers" Orientation="Horizontal" />
                        </StackPanel>

                        <ItemsControl x:Name="SessionStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tab" CornerRadius="{DynamicResource ControlRadius}" Margin="0,0,6,0" Padding="10,3,4,3"
                                            Background="Transparent" Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonDown="OnSessionTabClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- The agent's logo, or the profile's glyph for a shell or an agent without one. -->
                                            <Grid Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Data="{Binding Logo}" Fill="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            <!-- What the agent is doing, in its colour; nothing for a shell. -->
                                            <Ellipse Width="6" Height="6" Margin="7,0,0,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />
                                            <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="9"
                                                    Width="18" Height="18" Margin="6,0,0,0" Tag="{Binding}"
                                                    ToolTip="Close session" Click="OnSessionCloseClicked" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource ControlBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="212" />
                        </Grid.ColumnDefinitions>

                        <!-- The WebView2 that renders the sessions is added here in code. -->
                        <Border x:Name="TerminalHost" Background="{DynamicResource IslandBrush}" />
                        <TextBlock x:Name="TerminalEmpty" Opacity="0.45"
                                   Text="Start a session with the buttons above"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- The skills and subagents the coding agents would load, from .claude folders. -->
                        <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="12,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Skills &amp; agents" Style="{DynamicResource CardLabel}" />
                                <TextBlock x:Name="LibraryEmpty" DockPanel.Dock="Top" Margin="0,10,0,0" Opacity="0.45"
                                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="None found in this folder or your .claude folder" />
                                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                    <StackPanel>
                                        <TextBlock x:Name="LibrarySkillsHeader" Text="SKILLS" FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.4" Margin="0,0,0,4" Visibility="Collapsed" />
                                        <ItemsControl x:Name="LibrarySkillList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" Padding="0,3" ToolTip="{Binding Tip}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" FontSize="10" Opacity="0.4"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="LibraryAgentsHeader" Text="AGENTS" FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.4" Margin="0,10,0,4" Visibility="Collapsed" />
                                        <ItemsControl x:Name="LibraryAgentList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Click starts a Claude session as this subagent, with permissions bypassed. -->
                                                    <Border Padding="4,3" Margin="-4,0" Cursor="Hand" Tag="{Binding}"
                                                            CornerRadius="{DynamicResource ControlRadius}"
                                                            MouseLeftButtonDown="OnLibraryAgentClicked"
                                                            ToolTip="{Binding Tip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" FontSize="10" Opacity="0.4"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE768;" FontFamily="{DynamicResource IconFont}"
                                                                       FontSize="9" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Stats -->
                <UniformGrid x:Name="StatsPanel" Grid.Row="1" Margin="-6,10,-6,0" Columns="3" Rows="2"
                             Visibility="Collapsed">
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CPU" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsCpu" DockPanel.Dock="Top" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                            <shell:Sparkline x:Name="StatsCpuChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Memory" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsMemory" DockPanel.Dock="Top" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                            <TextBlock x:Name="StatsMemoryDetail" DockPanel.Dock="Top" FontSize="11" Opacity="0.55" />
                            <shell:Sparkline x:Name="StatsMemoryChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="GPU" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsGpu" DockPanel.Dock="Top" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                            <shell:Sparkline x:Name="StatsGpuChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Download" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsDownload" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Upload" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsUpload" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Battery" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsBattery" Text="&#x2013;" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Shelf: files dragged onto the notch, six to a row, to drag out again. Scrolls (wheel only) past three rows. -->
                <Grid x:Name="ShelfPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False">
                        <Button x:Name="ShelfClear" DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="Clear"
                                ToolTip="Take everything off the shelf. The files themselves stay where they are." />
                        <TextBlock x:Name="ShelfSummary" Style="{DynamicResource CardLabel}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="-6,4,-6,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="ShelfItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tile" Style="{DynamicResource Card}" Margin="6" Height="92" Padding="6,8,6,6"
                                            Tag="{Binding}" ToolTip="{Binding Path}" Cursor="Hand"
                                            MouseLeftButtonDown="OnShelfTilePressed" MouseMove="OnShelfTileMoved"
                                            MouseRightButtonUp="OnShelfTileMenu">
                                        <Grid>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,0,0,4">
                                                    <!-- Shows until the file's own picture has been fetched, and stays for a file that has none. -->
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="32"
                                                               Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding GlyphVisibility}" />
                                                    <Image Source="{Binding Picture}" Width="44" Height="44" Stretch="Uniform" />
                                                </Grid>
                                            </DockPanel>
                                            <Button x:Name="Remove" Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="8"
                                                    Width="18" Height="18" Margin="0,-6,-4,0" Tag="{Binding}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden"
                                                    ToolTip="Take off the shelf" Click="OnShelfRemoveClicked" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="ShelfEmpty" Grid.Row="1" Opacity="0.45" Text="Drag files onto the notch to keep them here"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Command palette: type to find something to do. Opened by its own hotkey; it has no tab button. -->
                <Grid x:Name="PalettePanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox x:Name="PaletteInput" Style="{StaticResource PillTextBox}" Padding="18,8,6,8" FontSize="15" />
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="15" Opacity="0.45"
                                   IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PaletteHint" IsHitTestVisible="False" Opacity="0.4" Margin="40,0,0,0"
                                   VerticalAlignment="Center" FontSize="15" Text="Type a command: timer, open stats, new Claude session…" />
                    </Grid>

                    <ItemsControl x:Name="PaletteList" Grid.Row="1" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="34" Margin="0,0,0,2" CornerRadius="{DynamicResource ControlRadius}"
                                        Background="{Binding Background}" Cursor="Hand" Tag="{Binding}"
                                        MouseLeftButtonDown="OnPaletteRowClicked">
                                    <DockPanel Margin="12,0">
                                        <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" Visibility="{Binding IconVisibility}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                       Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" FontSize="11" Opacity="0.5"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Clipboard: what was copied lately. Click a row to copy it again. -->
                <Grid x:Name="ClipboardPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button x:Name="ClipboardClear" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                Content="Clear" ToolTip="Forget everything except what is pinned" />
                        <Grid>
                            <TextBox x:Name="ClipboardSearch" Style="{StaticResource PillTextBox}" Padding="16,5,5,5" FontSize="13" />
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13" Opacity="0.45"
                                       IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClipboardSearchHint" IsHitTestVisible="False" Opacity="0.4" Margin="34,0,0,0"
                                       VerticalAlignment="Center" FontSize="13" Text="Search what you copied" />
                        </Grid>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ClipboardList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" Height="38" Margin="0,0,0,2"
                                            CornerRadius="{DynamicResource ControlRadius}" Tag="{Binding}"
                                            MouseLeftButtonDown="OnClipboardRowClicked" ToolTip="Click to copy it again">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="6,0,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28" HorizontalAlignment="Left">
                                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="{DynamicResource SmallRadius}" />
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                           Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.45" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{DynamicResource IconButton}" Content="&#xE8D5;" FontSize="12" Width="26" Height="26"
                                                        Tag="{Binding}" Visibility="{Binding ShelfVisibility}" ToolTip="Put these files on the shelf"
                                                        Click="OnClipboardShelfClicked" />
                                                <Button Style="{DynamicResource IconButton}" Content="{Binding PinGlyph}" FontSize="12" Width="26" Height="26"
                                                        Tag="{Binding}" ToolTip="{Binding PinTip}" Click="OnClipboardPinClicked" />
                                                <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                                                        Tag="{Binding}" ToolTip="Forget this one" Click="OnClipboardDeleteClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="ClipboardEmpty" Grid.Row="1" Opacity="0.45" Text="Things you copy will show up here"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Plugins: one card per PluginCard, three to a row. Scrolls (wheel only) past three rows. -->
                <ScrollViewer x:Name="PluginsPanel" Grid.Row="1" Margin="-6,10,-6,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ItemsControl x:Name="PluginCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="6" Height="95" Tag="{Binding}"
                                        Cursor="{Binding Cursor}" MouseLeftButtonUp="OnPluginCardClicked">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Label}"
                                                   Style="{DynamicResource CardLabel}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar DockPanel.Dock="Bottom" Height="4" Maximum="1" BorderThickness="0"
                                                     Foreground="{Binding AccentBrush}" Background="{DynamicResource TrackBrush}"
                                                     Value="{Binding Progress, Mode=OneTime}"
                                                     Visibility="{Binding ProgressVisibility}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   Style="{DynamicResource CardValue}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- A plugin's page: figures on top, a console below. Its tab button is added in code. -->
                <Grid x:Name="PagePanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="PageBack" DockPanel.Dock="Left" Margin="0,0,10,0"
                                Style="{DynamicResource PillButton}" Visibility="Collapsed" />
                        <StackPanel x:Name="PageActions" DockPanel.Dock="Right" Orientation="Horizontal" />
                        <TextBlock x:Name="PageStatus" VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,10,0" Visibility="Collapsed" />
                    </DockPanel>

                    <ItemsControl x:Name="PageStats" Grid.Row="1" Margin="-4,0,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="4" Height="84" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Label}"
                                                   Style="{DynamicResource CardLabel}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar DockPanel.Dock="Bottom" Height="4" Maximum="1" BorderThickness="0"
                                                     Foreground="{Binding AccentBrush}" Background="{DynamicResource TrackBrush}"
                                                     Value="{Binding Progress, Mode=OneTime}"
                                                     Visibility="{Binding ProgressVisibility}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer x:Name="PageChoicesScroll" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PageChoices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource PillButton}" Click="OnPageChoiceClick" Tag="{Binding}"
                                            HorizontalContentAlignment="Stretch" Margin="0,0,0,4" Padding="12,8">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageBlocksScroll" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel x:Name="PageBlockStack" Margin="2,4,2,0" />
                    </ScrollViewer>

                    <!-- A page the plugin draws itself (PluginPage.View) takes the figures' and the body's place. -->
                    <Border x:Name="PageViewHost" Grid.Row="1" Grid.RowSpan="2" Margin="0,6,0,0" Visibility="Collapsed" />

                    <Border x:Name="PageConsoleCard" Grid.Row="2" Style="{DynamicResource Card}" Margin="0,6,0,0" Padding="12,8">
                        <TextBox x:Name="PageConsole" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="{DynamicResource CodeFontFamily}" FontSize="12" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 VerticalScrollBarVisibility="Hidden" />
                    </Border>

                    <DockPanel x:Name="PageInputRow" Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="PageInputError" DockPanel.Dock="Bottom" FontSize="11" Margin="12,4,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <Button x:Name="PageSend" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                Content="Send" Background="{DynamicResource AccentHoverBrush}" />
                        <Grid>
                            <TextBox x:Name="PageInput" Style="{StaticResource PillTextBox}" Padding="10,5" FontSize="13"
                                     FontFamily="{DynamicResource CodeFontFamily}" />
                            <TextBlock x:Name="PageInputHint" IsHitTestVisible="False" Opacity="0.4" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontSize="13" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
