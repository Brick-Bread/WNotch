<Window x:Class="Notch.App.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Notch.App.Shell"
        Title="Notch"
        Width="980" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}">

    <!-- The window is as large as the notch ever gets. Everything outside the island is
         transparent, and transparent pixels of a layered window pass clicks through. -->
    <Grid x:Name="Root">
        <!-- Behind the island and slightly larger: a lit rim and its glow show. Sized and shaped in code. -->
        <Border x:Name="GlowLayer" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" />
        <Border x:Name="GlowCore" Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False" />

        <!-- Fills the gap between a floating island and the screen edge. All but invisible, yet
             enough for Windows to deliver the pointer here, so pushing it against the edge opens the island. -->
        <Border x:Name="EdgeBridge" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed" />

        <!-- Alignment and margins of the island, the glow and the bridge are set in code from the
             position and style settings; these are the values for a notch at the top. -->
        <Grid x:Name="Island" Width="180" Height="32"
              HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource IslandBrush}">

            <Grid x:Name="CompactLayer" Margin="16,0" Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CompactGlyph" FontFamily="{DynamicResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="{DynamicResource SmallRadius}"
                        VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CompactDetail" Grid.Column="2" VerticalAlignment="Center" Opacity="0.65"
                           MaxWidth="130" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="CompactProgress" Grid.Column="2" Width="110" Height="4" Maximum="1"
                             VerticalAlignment="Center" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" />
            </Grid>

            <!-- Fixed size per tab, so the content is revealed by the growing island instead of reflowing. -->
            <Grid x:Name="ExpandedLayer" Width="600" Height="324" Margin="0,16,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="TabStrip" Orientation="Horizontal">
                    <RadioButton x:Name="TabHome" Style="{DynamicResource TabButton}" Content="Home" IsChecked="True" />
                    <RadioButton x:Name="TabTerminal" Style="{DynamicResource TabButton}" Content="Terminal" />
                    <RadioButton x:Name="TabStats" Style="{DynamicResource TabButton}" Content="Stats" />
                    <RadioButton x:Name="TabShelf" Style="{DynamicResource TabButton}" Content="Shelf" />
                    <!-- Only shown while a plugin has a card to put on it. -->
                    <RadioButton x:Name="TabPlugins" Style="{DynamicResource TabButton}" Content="Plugins"
                                 Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="OpenSettingsButton" Style="{DynamicResource PillButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Content="&#xE713;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Settings" />

                <!-- Home: media, timer, calendar -->
                <StackPanel x:Name="HomePanel" Grid.Row="1" Margin="0,16,0,0">
                    <Grid x:Name="MediaCard" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="112" Height="112">
                            <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource ControlBrush}">
                                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                                           Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="MediaArt" CornerRadius="{DynamicResource CardRadius}" />
                        </Grid>

                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="MediaTitle" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MediaArtist" Grid.Row="1" Margin="0,2,0,0" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid x:Name="MediaTimeline" Grid.Row="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MediaElapsed" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                                <!-- Taller than the bar so it is easy to hit. -->
                                <Border x:Name="MediaSeekArea" Grid.Column="1" Height="18" Background="Transparent">
                                    <ProgressBar x:Name="MediaProgress" Height="4" Maximum="1" BorderThickness="0"
                                                 VerticalAlignment="Center" IsHitTestVisible="False"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" />
                                </Border>
                                <TextBlock x:Name="MediaRemaining" Grid.Column="2" FontSize="11" Opacity="0.65"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="MediaPrevious" Style="{DynamicResource IconButton}" Content="&#xE892;" />
                                <Button x:Name="MediaPlayPause" Style="{DynamicResource IconButton}" Content="&#xE768;"
                                        FontSize="22" Margin="14,0" />
                                <Button x:Name="MediaNext" Style="{DynamicResource IconButton}" Content="&#xE893;" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Height="150">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{DynamicResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <!-- Negative margins keep the label row as low as it is without the button. -->
                                    <Button x:Name="TimerCustom" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="+ Custom" FontSize="11" Padding="8,2" Margin="0,-4,-4,-4"
                                            ToolTip="Set a timer of any length" />
                                    <TextBlock x:Name="TimerLabel" Text="Timer" Style="{DynamicResource CardLabel}" />
                                </DockPanel>
                                <!-- Wraps to a second row when the presets do not fit on one. -->
                                <WrapPanel x:Name="TimerPresets" DockPanel.Dock="Bottom" Margin="-6,0,0,0">
                                    <Button x:Name="TimerPomodoro" Style="{DynamicResource PillButton}" Content="Pomodoro"
                                            Margin="6,6,0,0" Background="{DynamicResource AccentHoverBrush}"
                                            ToolTip="Focus and break sessions back to back; lengths are in Settings" />
                                    <!-- A button per preset from the settings follows, added in code. -->
                                </WrapPanel>
                                <!-- Takes the place of the presets while a length is being typed. -->
                                <DockPanel x:Name="TimerEntry" DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Button x:Name="TimerEntryCancel" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="Cancel" />
                                    <Button x:Name="TimerEntryStart" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                            Content="Start" Background="{DynamicResource AccentHoverBrush}" />
                                    <TextBox x:Name="TimerInput" Style="{StaticResource PillTextBox}" MaxLength="24"
                                             ToolTip="A number is minutes. Also 1:30, 90s, 1h20m. Enter starts, Esc cancels." />
                                </DockPanel>
                                <StackPanel x:Name="TimerControls" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            Margin="-6,6,0,0" Visibility="Collapsed">
                                    <Button x:Name="TimerPauseResume" Style="{DynamicResource PillButton}" Content="Pause" />
                                    <Button x:Name="TimerReset" Style="{DynamicResource PillButton}" Content="Cancel" />
                                </StackPanel>
                                <!-- Shrinks the digits when two rows of presets leave them less room. -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="TimerText" Text="0:00" FontSize="34" FontWeight="SemiBold" />
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{DynamicResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="CalendarDate" DockPanel.Dock="Top" Style="{DynamicResource CardLabel}" />
                                <TextBlock x:Name="CalendarEmpty" Opacity="0.45" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ItemsControl x:Name="CalendarList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- One colour per feed, so calendars can be told apart. -->
                                                <Ellipse Width="6" Height="6" HorizontalAlignment="Left"
                                                         VerticalAlignment="Center" Fill="{Binding Dot}" />
                                                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12" Opacity="0.6" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Terminal -->
                <Grid x:Name="TerminalPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="TerminalFolder" Style="{DynamicResource PillButton}" />
                            <StackPanel x:Name="TerminalLaunchers" Orientation="Horizontal" />
                        </StackPanel>

                        <ItemsControl x:Name="SessionStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tab" CornerRadius="{DynamicResource ControlRadius}" Margin="0,0,6,0" Padding="10,4,4,4"
                                            Background="Transparent" Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonDown="OnSessionTabClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="9"
                                                    Width="18" Height="18" Margin="6,0,0,0" Tag="{Binding}"
                                                    ToolTip="Close session" Click="OnSessionCloseClicked" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- The WebView2 that renders the sessions is added here in code. -->
                    <Border x:Name="TerminalHost" Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource IslandBrush}" />
                    <TextBlock x:Name="TerminalEmpty" Grid.Row="1" Opacity="0.45"
                               Text="Start a session with the buttons above"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Stats -->
                <UniformGrid x:Name="StatsPanel" Grid.Row="1" Margin="-6,10,-6,0" Columns="3" Rows="2"
                             Visibility="Collapsed">
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CPU" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsCpu" DockPanel.Dock="Top" Text="â€“" Style="{DynamicResource CardValue}" />
                            <shell:Sparkline x:Name="StatsCpuChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Memory" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsMemory" DockPanel.Dock="Top" Text="â€“" Style="{DynamicResource CardValue}" />
                            <TextBlock x:Name="StatsMemoryDetail" DockPanel.Dock="Top" FontSize="11" Opacity="0.55" />
                            <shell:Sparkline x:Name="StatsMemoryChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="GPU" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsGpu" DockPanel.Dock="Top" Text="â€“" Style="{DynamicResource CardValue}" />
                            <shell:Sparkline x:Name="StatsGpuChart" Margin="0,6,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Download" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsDownload" Text="â€“" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Upload" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsUpload" Text="â€“" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Battery" Style="{DynamicResource CardLabel}" />
                            <TextBlock x:Name="StatsBattery" Text="â€“" Style="{DynamicResource CardValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Shelf: files dragged onto the notch, six to a row, to drag out again. Scrolls (wheel only) past three rows. -->
                <Grid x:Name="ShelfPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False">
                        <Button x:Name="ShelfClear" DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="Clear"
                                ToolTip="Take everything off the shelf. The files themselves stay where they are." />
                        <TextBlock x:Name="ShelfSummary" Style="{DynamicResource CardLabel}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="-6,4,-6,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="ShelfItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tile" Style="{DynamicResource Card}" Margin="6" Height="92" Padding="6,8,6,6"
                                            Tag="{Binding}" ToolTip="{Binding Path}" Cursor="Hand"
                                            MouseLeftButtonDown="OnShelfTilePressed" MouseMove="OnShelfTileMoved"
                                            MouseRightButtonUp="OnShelfTileMenu">
                                        <Grid>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="11"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,0,0,4">
                                                    <!-- Shows until the file's own picture has been fetched, and stays for a file that has none. -->
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="30"
                                                               Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding GlyphVisibility}" />
                                                    <Image Source="{Binding Picture}" Width="44" Height="44" Stretch="Uniform" />
                                                </Grid>
                                            </DockPanel>
                                            <Button x:Name="Remove" Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="8"
                                                    Width="18" Height="18" Margin="0,-6,-4,0" Tag="{Binding}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden"
                                                    ToolTip="Take off the shelf" Click="OnShelfRemoveClicked" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="ShelfEmpty" Grid.Row="1" Opacity="0.45" Text="Drag files onto the notch to keep them here"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Plugins: one card per PluginCard, three to a row. Scrolls (wheel only) past three rows. -->
                <ScrollViewer x:Name="PluginsPanel" Grid.Row="1" Margin="-6,10,-6,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ItemsControl x:Name="PluginCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="6" Height="95" Tag="{Binding}"
                                        Cursor="{Binding Cursor}" MouseLeftButtonUp="OnPluginCardClicked">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Label}"
                                                   Style="{DynamicResource CardLabel}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar DockPanel.Dock="Bottom" Height="4" Maximum="1" BorderThickness="0"
                                                     Foreground="{Binding AccentBrush}" Background="{DynamicResource TrackBrush}"
                                                     Value="{Binding Progress, Mode=OneTime}"
                                                     Visibility="{Binding ProgressVisibility}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   Style="{DynamicResource CardValue}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- A plugin's page: figures on top, a console below. Its tab button is added in code. -->
                <Grid x:Name="PagePanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                        <Button x:Name="PageBack" DockPanel.Dock="Left" Margin="0"
                                Style="{DynamicResource PillButton}" Visibility="Collapsed" />
                        <StackPanel x:Name="PageActions" DockPanel.Dock="Right" Orientation="Horizontal" />
                    </DockPanel>

                    <ItemsControl x:Name="PageStats" Grid.Row="1" Margin="-4,0,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="4" Height="84" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Label}"
                                                   Style="{DynamicResource CardLabel}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar DockPanel.Dock="Bottom" Height="4" Maximum="1" BorderThickness="0"
                                                     Foreground="{Binding AccentBrush}" Background="{DynamicResource TrackBrush}"
                                                     Value="{Binding Progress, Mode=OneTime}"
                                                     Visibility="{Binding ProgressVisibility}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer x:Name="PageChoicesScroll" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PageChoices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource PillButton}" Click="OnPageChoiceClick" Tag="{Binding}"
                                            HorizontalContentAlignment="Stretch" Margin="0,0,0,4" Padding="12,8">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageBlocksScroll" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel x:Name="PageBlockStack" Margin="2,4,2,0" />
                    </ScrollViewer>

                    <Border x:Name="PageConsoleCard" Grid.Row="2" Style="{DynamicResource Card}" Margin="0,6,0,0" Padding="12,8">
                        <TextBox x:Name="PageConsole" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="{DynamicResource CodeFontFamily}" FontSize="12" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 VerticalScrollBarVisibility="Hidden" />
                    </Border>

                    <DockPanel x:Name="PageInputRow" Grid.Row="3" Margin="0,8,0,0">
                        <Button x:Name="PageSend" DockPanel.Dock="Right" Style="{DynamicResource PillButton}"
                                Content="Send" Background="{DynamicResource AccentHoverBrush}" />
                        <Grid>
                            <TextBox x:Name="PageInput" Style="{StaticResource PillTextBox}" Padding="10,5" FontSize="13"
                                     FontFamily="{DynamicResource CodeFontFamily}" />
                            <TextBlock x:Name="PageInputHint" IsHitTestVisible="False" Opacity="0.4" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontSize="13" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
