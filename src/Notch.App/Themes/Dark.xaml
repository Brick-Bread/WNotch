<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light.xaml defines the same keys. Fills are translucent so they sit on any island colour. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />

    <!-- Used when no accent colour is chosen; ThemeManager overrides these three when one is. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4DFFFFFF" />

    <!-- Panels and the resting, hovered and pressed states of controls, faintest first. -->
    <SolidColorBrush x:Key="CardBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#40FFFFFF" />

    <!-- The hairline round a panel, and the raised segment of the tab strip. -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#47FFFFFF" />

    <!-- The unfilled part of a progress bar. -->
    <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF" />
</ResourceDictionary>
