<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light.xaml defines the same keys. Fills are translucent so they sit on any island colour. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />
    <!-- Artists, folders, times and labels: the text that comes second. -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8FF5F5F7" />

    <!-- Used when no accent colour is chosen; ThemeManager overrides these three when one is. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4DFFFFFF" />

    <!-- Panels and the resting, hovered and pressed states of controls, faintest first. Panels have
         no edge: the one faint fill is enough to group what is in them. -->
    <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#38FFFFFF" />

    <!-- The edge round a panel (none by default), and the selected tab. -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1CFFFFFF" />

    <!-- The unfilled part of a progress bar. -->
    <SolidColorBrush x:Key="TrackBrush" Color="#29FFFFFF" />

    <!-- What an agent is doing, and errors. These colour the state, never an agent's logo. -->
    <SolidColorBrush x:Key="WorkingBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="DoneBrush" Color="#30D158" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />

    <!-- Settings and Notch's other ordinary windows: their background, a switch that is on, and text on the accent. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#141415" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0B0C" />
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#30D158" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
</ResourceDictionary>
