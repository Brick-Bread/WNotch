<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Dark.xaml. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />

    <!-- Used when no accent colour is chosen; ThemeManager overrides these three when one is. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#24000000" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#38000000" />

    <!-- White panels on the grey island; controls are grey on top of them. -->
    <SolidColorBrush x:Key="CardBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2B000000" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TrackBrush" Color="#1F000000" />
</ResourceDictionary>
