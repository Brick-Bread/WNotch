<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Dark.xaml. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#941D1D1F" />

    <!-- Used when no accent colour is chosen; ThemeManager overrides these three when one is. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#24000000" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#38000000" />

    <SolidColorBrush x:Key="CardBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="ControlBrush" Color="#13000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#26000000" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#13000000" />

    <SolidColorBrush x:Key="TrackBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="WorkingBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#C93400" />
    <SolidColorBrush x:Key="DoneBrush" Color="#248A3D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D70015" />

    <!-- Settings and Notch's other ordinary windows: their background, a switch that is on, and text on the accent. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FBFBFD" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EEEEF1" />
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#34C759" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
