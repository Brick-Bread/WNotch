<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Paper over Light.xaml: warm paper with ink. Same keys as PaperDark.xaml. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#F6F3EC" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#141F1C17" />
    <Thickness x:Key="IslandBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="TextBrush" Color="#1F1C17" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#941F1C17" />

    <SolidColorBrush x:Key="CardBrush" Color="#0F3B2A12" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F3B2A12" />
    <SolidColorBrush x:Key="ControlBrush" Color="#173B2A12" />
    <SolidColorBrush x:Key="HoverBrush" Color="#213B2A12" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2E3B2A12" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#173B2A12" />
    <SolidColorBrush x:Key="TrackBrush" Color="#213B2A12" />

    <SolidColorBrush x:Key="WorkingBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="DoneBrush" Color="#15803D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#FBF9F4" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#1F1C17" />
    <SolidColorBrush x:Key="TerminalCursorBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="TerminalSelectionBrush" Color="#33C2410C" />

    <FontFamily x:Key="DisplayFontFamily">Iowan Old Style, Georgia, Cambria</FontFamily>

    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <sys:Double x:Key="IslandRadiusScale">0.8</sys:Double>
</ResourceDictionary>
