<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Hairline over Light.xaml: milky glass with a one-pixel outline. Same keys as HairlineDark.xaml. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#2E000000" />
    <Thickness x:Key="IslandBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="TextBrush" Color="#111111" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E111111" />

    <SolidColorBrush x:Key="CardBrush" Color="#00000000" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ControlBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#17000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#12000000" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#111111" />

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, /Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display Light, Segoe UI Light, /Assets/Fonts/#Inter Display</FontFamily>

    <CornerRadius x:Key="CardRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallRadius">3</CornerRadius>
    <CornerRadius x:Key="IconButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="RowRadius">4</CornerRadius>
    <sys:Double x:Key="IslandRadiusScale">0.5</sys:Double>
</ResourceDictionary>
