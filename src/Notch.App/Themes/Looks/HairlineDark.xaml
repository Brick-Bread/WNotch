<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Hairline over Dark.xaml: smoky glass with a one-pixel outline. Panels have no fill, only a hairline
         edge, and corners are tight. Only the keys that differ from Dark.xaml are here. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#9E0C0C0E" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#38FFFFFF" />
    <Thickness x:Key="IslandBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="TextBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94FAFAFA" />

    <SolidColorBrush x:Key="CardBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF" />

    <SolidColorBrush x:Key="WorkingBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="DoneBrush" Color="#86EFAC" />

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0E0E10" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#FAFAFA" />

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, /Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display Light, Segoe UI Light, /Assets/Fonts/#Inter Display</FontFamily>

    <CornerRadius x:Key="CardRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallRadius">3</CornerRadius>
    <CornerRadius x:Key="IconButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="RowRadius">4</CornerRadius>
    <sys:Double x:Key="IslandRadiusScale">0.5</sys:Double>
</ResourceDictionary>
