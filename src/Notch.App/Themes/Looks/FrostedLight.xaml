<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Frosted over Light.xaml: milky glass with a bright rim. Same keys as FrostedDark.xaml. -->
    <SolidColorBrush x:Key="IslandBrush" Color="#B3F7F7FA" />
    <LinearGradientBrush x:Key="IslandBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#80FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <Thickness x:Key="IslandBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AD1D1D1F" />

    <SolidColorBrush x:Key="CardBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F4F4F8" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#1D1D1F" />

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, /Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, /Assets/Fonts/#Inter Display</FontFamily>
</ResourceDictionary>
