<Application x:Class="Notch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Nothing is defined here directly: a dictionary's own entries win over the ones merged into it,
                 and a plugin theme merged later must be able to replace any of them. Colours come from
                 Themes/Dark.xaml or Light.xaml, which ThemeManager merges in at startup, followed by the theme
                 a plugin offers, if one is chosen. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Design.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
