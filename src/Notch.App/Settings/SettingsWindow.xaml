<Window x:Class="Notch.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch settings"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Scrolls on screens too short for the whole window; see the MaxHeight set in code. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,20">
        <StackPanel.Resources>
            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="General" Style="{StaticResource Heading}" />
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" />
        <CheckBox x:Name="ExpandOnHover" Content="Open the notch when the pointer hovers over it" />
        <CheckBox x:Name="HideInFullscreen" Content="Hide while an app is fullscreen" />
        <CheckBox x:Name="AutoUpdate" Content="Install updates automatically"
                  ToolTip="Checks GitHub for new releases, installs them in the background and restarts Notch when it is not in use." />
        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Display" VerticalAlignment="Center" Width="64" />
            <ComboBox x:Name="Display" />
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Theme" VerticalAlignment="Center" Width="64" />
            <ComboBox x:Name="Theme">
                <ComboBoxItem Content="Dark" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Follow Windows" />
            </ComboBox>
        </DockPanel>

        <TextBlock Text="Show in the pill" Style="{StaticResource Heading}" Margin="0,22,0,8" />
        <CheckBox x:Name="GlowEffects" Content="Glow effects (colour and rhythm follow what is happening)" />
        <DockPanel Margin="28,0,0,6" IsEnabled="{Binding IsChecked, ElementName=GlowEffects}">
            <TextBlock Text="Brightness" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="GlowIntensityText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                       VerticalAlignment="Center" />
            <Slider x:Name="GlowIntensity" TickFrequency="5" IsSnapToTickEnabled="True"
                    SmallChange="5" LargeChange="25" VerticalAlignment="Center" />
        </DockPanel>
        <CheckBox x:Name="ShowMedia" Content="Media that is playing" />
        <CheckBox x:Name="ShowVolume" Content="Volume and audio output changes" />
        <CheckBox x:Name="ShowBrightness" Content="Brightness changes" />
        <CheckBox x:Name="ShowPower" Content="Charging and low battery" />
        <CheckBox x:Name="ShowBluetooth" Content="Bluetooth devices connecting" />

        <TextBlock Text="Pomodoro (minutes)" Style="{StaticResource Heading}" Margin="0,22,0,8" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Focus" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="PomodoroFocus" Width="56" />
            <TextBlock Text="Short break" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="PomodoroShortBreak" Width="56" />
            <TextBlock Text="Long break" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="PomodoroLongBreak" Width="56" />
        </StackPanel>

        <TextBlock Text="Calendar feeds" Style="{StaticResource Heading}" Margin="0,22,0,4" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                   Text="One iCalendar (.ics) link per line. Google Calendar and Outlook both offer a private link under their sharing settings." />
        <TextBox x:Name="CalendarFeeds" AcceptsReturn="True" Height="76" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <DockPanel Margin="0,22,0,4">
            <Button x:Name="OpenPluginsFolder" DockPanel.Dock="Right" Content="Open folder"
                    ToolTip="Each plugin is a folder in here. Reopen settings after adding one." />
            <TextBlock Text="Plugins" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                   Text="Plugins can do anything Notch itself can do on this PC. Only switch on plugins you trust." />
        <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
            <!-- One check box per installed plugin, added in code. -->
            <StackPanel x:Name="PluginList" />
        </ScrollViewer>
        <TextBlock Text="Install from GitHub: a repository as owner/name, or its link" Opacity="0.7"
                   Margin="0,12,0,6" />
        <DockPanel>
            <Button x:Name="InstallPlugin" DockPanel.Dock="Right" Content="Install" MinWidth="88" Margin="8,0,0,0"
                    ToolTip="Downloads the plugin attached to the repository's latest release." />
            <TextBox x:Name="PluginSource" />
        </DockPanel>
        <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,24,0,0">
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Cancel" Content="Cancel" MinWidth="88" IsCancel="True" />
                <Button x:Name="Save" Content="Save" MinWidth="88" Margin="8,0,0,0" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
