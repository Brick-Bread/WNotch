<Window x:Class="Notch.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch settings"
        Width="880" Height="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Notch;component/Themes/Window.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A round colour swatch; the ring shows which one is chosen. Background is the colour. -->
            <Style x:Key="Swatch" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Accent" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{DynamicResource TextBrush}"
                                         Visibility="Hidden" />
                                <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row: a label on the left and its control filling a fixed width on the right. -->
            <Style x:Key="Row" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,7" />
                <Setter Property="LastChildFill" Value="False" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="NotchWindow" />
    </Window.Style>

    <!-- No title bar of Windows' own: the top of the window is drawn here and drags it. The one-pixel glass
         frame keeps Windows 11's rounded corners and shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sections. -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="10,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,18">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#000000">
                        <Border Width="14" Height="5" CornerRadius="2.5" Background="#F5F5F7" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Notch" FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarVersion" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="Sections">
                    <RadioButton Style="{StaticResource SidebarItem}" Content="General" Tag="&#xE713;" IsChecked="True" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Appearance" Tag="&#xE790;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Pill" Tag="&#xE7F4;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Agents" Tag="&#xE99A;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Notifications" Tag="&#xEA8F;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Clipboard" Tag="&#xE77F;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Terminal" Tag="&#xE756;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Timer" Tag="&#xE916;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Calendar" Tag="&#xE787;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Automation" Tag="&#xE945;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="Plugins" Tag="&#xEA86;" />
                    <RadioButton Style="{StaticResource SidebarItem}" Content="About" Tag="&#xE946;" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- The title bar: the section's name, and minimise and close. -->
            <DockPanel DockPanel.Dock="Top" Height="44" Margin="28,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close without saving" />
                </StackPanel>
                <TextBlock x:Name="SectionTitle" Text="General" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Save and Cancel, under every section. -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlBrush}" Padding="20,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="Cancel" Content="Cancel" MinWidth="84" IsCancel="True" />
                        <Button x:Name="Save" Content="Save" MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>
                    <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
                <Grid x:Name="Pages">
                    <!-- General -->
                    <StackPanel Tag="General">
                        <TextBlock Text="STARTUP" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindows" Content="Start with Windows" />
                                <CheckBox x:Name="NotifyOfUpdates" Content="Tell me when an update is available"
                                          ToolTip="Checks GitHub for new releases and shows a notice in the pill. Nothing is installed until you press Update Notch now." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="ExpandOnHover" Content="Open the notch when the pointer hovers over it" />
                                <CheckBox x:Name="ShelfOpensOnDrag" Content="Open the Shelf when files are dragged onto the pill"
                                          ToolTip="When off, files dropped on the pill still go on the shelf; the notch just stays closed." />
                                <CheckBox x:Name="HideInFullscreen" Content="Hide while a game or other fullscreen app is showing" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PLACE" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Display" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="Display" DockPanel.Dock="Right" Width="260" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Position" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="Position" DockPanel.Dock="Right" Width="260">
                                        <ComboBoxItem Content="Top of the screen" />
                                        <ComboBoxItem Content="Taskbar, far left" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Style" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="IslandStyle" DockPanel.Dock="Right" Width="260">
                                        <ComboBoxItem Content="Notch (attached to the screen edge)" />
                                        <ComboBoxItem Content="Dynamic Island (floating pill)" />
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="HOTKEYS" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Open and close the notch" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="OpenHotkey" DockPanel.Dock="Right" Width="260"
                                             ToolTip="Opens and closes the notch from any app. Ctrl, Alt, Shift and Win with a letter, a digit, F1 to F24 or Space, such as Alt+Shift+N or Ctrl+Alt+F12. Leave empty for none." />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Command palette" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="PaletteHotkey" DockPanel.Dock="Right" Width="260"
                                             ToolTip="Opens the command palette from any app: a box to type what you want, such as a timer or a tab. Same format as the hotkey above. Leave empty for none." />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel Tag="Appearance" Visibility="Collapsed">
                        <TextBlock Text="LOOK" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="Theme" DockPanel.Dock="Right" Width="260">
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Follow Windows" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Plugin theme" Style="{StaticResource RowLabel}" />
                                    <ComboBox x:Name="PluginTheme" DockPanel.Dock="Right" Width="260"
                                              ToolTip="A look for the whole notch that a plugin offers. It replaces the theme above while it is chosen. Only plugins that are switched on and running offer themes." />
                                </DockPanel>
                                <TextBlock x:Name="PluginThemeProblem" Style="{StaticResource Help}" Foreground="{DynamicResource DangerBrush}"
                                           Visibility="Collapsed" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Accent" Style="{StaticResource RowLabel}" />
                                    <!-- One swatch per colour, added in code. -->
                                    <StackPanel x:Name="AccentSwatches" DockPanel.Dock="Right" Orientation="Horizontal" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Pill -->
                    <StackPanel Tag="Pill" Visibility="Collapsed">
                        <TextBlock Text="GLOW" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="GlowEffects" Content="Glow effects (colour and rhythm follow what is happening)" />
                                <DockPanel Style="{StaticResource Row}" LastChildFill="True"
                                           IsEnabled="{Binding IsChecked, ElementName=GlowEffects}">
                                    <TextBlock Text="Brightness" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="GlowIntensityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Typography.NumeralAlignment="Tabular" />
                                    <Slider x:Name="GlowIntensity" TickFrequency="5" IsSnapToTickEnabled="True"
                                            SmallChange="5" LargeChange="25" VerticalAlignment="Center" Margin="40,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SHOW IN THE PILL" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="ShowMedia" Content="Media that is playing" />
                                <CheckBox x:Name="ShowVolume" Content="Volume and audio output changes" />
                                <CheckBox x:Name="ShowBrightness" Content="Brightness changes" />
                                <CheckBox x:Name="ShowPower" Content="Charging and low battery" />
                                <CheckBox x:Name="ShowBluetooth" Content="Bluetooth devices connecting" />
                                <CheckBox x:Name="ShowCapsLock" Content="Caps Lock switching on or off" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Agents -->
                    <StackPanel Tag="Agents" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Help}" Margin="4,4,0,6"
                                   Text="Notch lists coding agents running anywhere on this PC, not only those started from its terminal. Clicking one brings its window to the front. Whether an agent is working, waiting for you or done is known only for agents that report it through hooks." />
                        <TextBlock Text="FINDING AGENTS" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="DetectAgents" Content="Show agents running outside Notch's terminal"
                                          ToolTip="Looks at the running programs every few seconds for Claude Code, Codex, opencode, Gemini CLI and Aider. Sessions that only run in the background of a desktop app are left out." />
                                <StackPanel x:Name="AgentToggles" Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=DetectAgents}" />
                                <CheckBox x:Name="WatchAppSessions" Content="Show sessions open in the Claude and ChatGPT apps"
                                          ToolTip="Reads the files the Claude app keeps for its Code tab and the ChatGPT app keeps for its Codex threads, so their sessions show as working, waiting for you or done. Nothing is changed in those files." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="REPORTING" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="GlobalAgentHooks" Content="Let agents report what they are doing, wherever they run"
                                          ToolTip="Adds Notch's hooks to Claude Code's settings.json and Codex's config.toml, and a small plugin to opencode's plugins folder. Notch keeps a backup of each file it edits and takes everything out again when you untick this." />
                                <TextBlock Style="{StaticResource Help}"
                                           Text="Edits ~\.claude\settings.json and ~\.codex\config.toml after asking, with a backup next to each, and adds one file, plugins\notch.js, to opencode's config folder (opencode 2). Codex runs only one notify command, so an existing one is never replaced." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SOUNDS" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="AgentSounds" Content="Play a sound when an agent is done or needs me"
                                          ToolTip="Only for agents that report what they are doing. Never while a game or other fullscreen app is showing." />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=AgentSounds}">
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Done" Style="{StaticResource RowLabel}" />
                                        <Button x:Name="PlayDoneSound" DockPanel.Dock="Right" Content="Play" Margin="6,0,0,0" />
                                        <Button x:Name="ChooseDoneSound" DockPanel.Dock="Right" Content="Choose…" Margin="6,0,0,0" />
                                        <TextBox x:Name="DoneSound" DockPanel.Dock="Right" Width="220"
                                                 ToolTip="A .wav file. Leave empty for the sound Notch comes with." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Needs input" Style="{StaticResource RowLabel}" />
                                        <Button x:Name="PlayNeedsInputSound" DockPanel.Dock="Right" Content="Play" Margin="6,0,0,0" />
                                        <Button x:Name="ChooseNeedsInputSound" DockPanel.Dock="Right" Content="Choose…" Margin="6,0,0,0" />
                                        <TextBox x:Name="NeedsInputSound" DockPanel.Dock="Right" Width="220"
                                                 ToolTip="A .wav file. Leave empty for the sound Notch comes with." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}" LastChildFill="True">
                                        <TextBlock Text="Volume" Style="{StaticResource RowLabel}" />
                                        <TextBlock x:Name="SoundVolumeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <Slider x:Name="SoundVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                SmallChange="5" LargeChange="25" VerticalAlignment="Center" Margin="40,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Notifications -->
                    <StackPanel Tag="Notifications" Visibility="Collapsed">
                        <TextBlock Text="WINDOWS NOTIFICATIONS" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="MirrorNotifications" Content="Show Windows notifications in the pill" />
                                <TextBlock Style="{StaticResource Help}"
                                           Text="Shows who it is from (or its subject) and which app, briefly. The message itself is never shown. Windows has to allow it under Settings, Privacy and security, Notifications." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ONLY THESE APPS, ONE PER LINE (EMPTY MEANS ALL)" Style="{StaticResource Heading}" />
                        <TextBox x:Name="MirroredApps" AcceptsReturn="True" Height="96" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsChecked, ElementName=MirrorNotifications}" />
                    </StackPanel>

                    <!-- Clipboard -->
                    <StackPanel Tag="Clipboard" Visibility="Collapsed">
                        <TextBlock Text="HISTORY" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="ClipboardHistory" Content="Keep a history of what I copy (adds a Clipboard tab)" />
                                <TextBlock Style="{StaticResource Help}"
                                           Text="Kept in memory and gone when Notch quits, except what you pin. Copies that password managers mark as private are never kept." />
                                <Button x:Name="ClearClipboard" Content="Clear the history now" HorizontalAlignment="Left" Margin="0,2,0,10" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Terminal -->
                    <StackPanel Tag="Terminal" Visibility="Collapsed">
                        <TextBlock Text="TERMINAL BUTTONS" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Margin="4,0,0,8"
                                   Text="One per line, up to six: Name = command arguments. Put NAME=value pairs before the command to set environment variables for that button only, for example &quot;Work Claude = CLAUDE_CONFIG_DIR=C:\work claude&quot; or &quot;Codex fork = my-codex --model o3&quot;. A command with claude or codex in its name gets the agent status in the pill." />
                        <TextBox x:Name="TerminalPresets" AcceptsReturn="True" Height="150" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Timer -->
                    <StackPanel Tag="Timer" Visibility="Collapsed">
                        <TextBlock Text="PRESETS" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Margin="4,0,0,8"
                                   Text="One per line, up to six: a length such as 5m, 1:30 or 1h20m, with a name in front if you like (Tea 3m). The + button on the timer card takes any other length." />
                        <TextBox x:Name="TimerPresets" AcceptsReturn="True" Height="130" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="POMODORO, IN MINUTES" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Focus" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="PomodoroFocus" DockPanel.Dock="Right" Width="72" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Short break" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="PomodoroShortBreak" DockPanel.Dock="Right" Width="72" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Long break" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="PomodoroLongBreak" DockPanel.Dock="Right" Width="72" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Calendar -->
                    <StackPanel Tag="Calendar" Visibility="Collapsed">
                        <TextBlock Text="CALENDAR FEEDS" Style="{StaticResource Heading}" Margin="4,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Margin="4,0,0,8"
                                   Text="One iCalendar (.ics) link per line. Google Calendar and Outlook both offer a private link under their sharing settings." />
                        <TextBox x:Name="CalendarFeeds" AcceptsReturn="True" Height="130" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Automation -->
                    <StackPanel Tag="Automation" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Help}" Margin="4,4,0,6"
                                   Text="notchctl.exe (in the Notch folder) and notch:// links can start timers and show notices. The webhook lets scripts and other programs on this PC put activities in the pill: it listens on this computer only, and every request must carry the token." />
                        <TextBlock Text="WEBHOOK" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="WebhookEnabled" Content="Accept requests on a local webhook" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=WebhookEnabled}">
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Port" Style="{StaticResource RowLabel}" />
                                        <TextBox x:Name="WebhookPort" DockPanel.Dock="Right" Width="96" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}" LastChildFill="True">
                                        <TextBlock Text="Token" Style="{StaticResource RowLabel}" />
                                        <Button x:Name="NewWebhookToken" DockPanel.Dock="Right" Content="New token" Margin="6,0,0,0" />
                                        <Button x:Name="CopyWebhookToken" DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" />
                                        <TextBox x:Name="WebhookToken" IsReadOnly="True" Margin="40,0,0,0"
                                                 FontFamily="{DynamicResource CodeFontFamily}" FontSize="12" />
                                    </DockPanel>
                                    <TextBlock x:Name="WebhookExample" Style="{StaticResource Help}"
                                               FontFamily="{DynamicResource CodeFontFamily}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Plugins -->
                    <StackPanel Tag="Plugins" Visibility="Collapsed">
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="BrowsePlugins" Content="Browse plugins" Margin="0,0,8,8"
                                    Style="{StaticResource AccentButton}" ToolTip="The plugins listed on the Notch website." />
                            <Button x:Name="OpenPluginsFolder" Content="Open folder" Margin="0,0,8,8"
                                    ToolTip="Each plugin is a folder in here. Reopen settings after adding one." />
                            <Button x:Name="CheckPluginUpdates" Content="Check for updates" Margin="0,0,8,8"
                                    ToolTip="Asks GitHub whether the plugins installed from it have newer releases." />
                            <Button x:Name="StopPlugins" Content="Stop all" Margin="0,0,8,8"
                                    ToolTip="Ends every running plugin at once and switches them all off." />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Help}" Margin="4,0,0,4"
                                   Text="Plugins can do anything Notch itself can do on this PC. Only switch on plugins you trust." />
                        <TextBlock Text="INSTALLED" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Group}">
                            <!-- One switch per installed plugin, with its options and any update, added in code. -->
                            <StackPanel x:Name="PluginList" Margin="0,4" />
                        </Border>
                        <TextBlock x:Name="PluginUpdateStatus" Style="{StaticResource Help}" Margin="4,6,0,0" Visibility="Collapsed" />

                        <TextBlock Text="INSTALL FROM GITHUB" Style="{StaticResource Heading}" />
                        <DockPanel>
                            <Button x:Name="InstallPlugin" DockPanel.Dock="Right" Content="Install" MinWidth="84" Margin="8,0,0,0"
                                    ToolTip="Downloads the plugin attached to the repository's latest release." />
                            <TextBox x:Name="PluginSource" ToolTip="A repository as owner/name, or its link" />
                        </DockPanel>
                        <TextBlock x:Name="InstallStatus" Style="{StaticResource Help}" Margin="4,6,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Tag="About" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="4,8,0,16">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#000000">
                                <Border Width="28" Height="9" CornerRadius="4.5" Background="#F5F5F7" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Notch" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Updates" Style="{StaticResource RowLabel}" />
                                    <Button x:Name="UpdateNotch" DockPanel.Dock="Right" Content="Update Notch now"
                                            ToolTip="Checks GitHub for a newer Notch, installs it even if update notices are off, and restarts Notch." />
                                </DockPanel>
                                <TextBlock x:Name="NotchUpdateStatus" Style="{StaticResource Help}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
